{
  "manifest_version": 3,
  "name": "Call Companion – MiniCRM session relay",
  "version": "0.4.0",
  "description": "Sends the MiniCRM session cookies to the local Call Companion app (127.0.0.1 only).",
  "permissions": ["cookies", "alarms"],
  "host_permissions": ["https://r3.minicrm.hu/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://r3.minicrm.hu/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
